# Dockerfile
FROM python:3.11-slim

# Чтобы логи сразу шли в stdout без буфера
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Системные зависимости (минимум; requests/telebot обычно без доп. пакетов)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Устанавливаем зависимости
# (Если у тебя есть requirements.txt — см. вариант ниже)
RUN pip install --no-cache-dir pytelegrambotapi requests

# Копируем код бота
# Переименуй свой файл в bot.py или поправь команду запуска ниже
COPY bot.py /app/bot.py

# Запуск
CMD ["python", "/app/bot.py"]
